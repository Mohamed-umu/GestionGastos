<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="umu.tds.GestionGastos.CuentaCompartidaController">

    <content>

        <VBox spacing="14">

            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>

            <!-- TÍTULO -->
            <VBox spacing="3">
                <Label text="Cuentas de gasto compartidas" styleClass="titulo-principal"/>
                <Label text="Gestiona cuentas compartidas, personas, porcentajes y saldos pendientes" styleClass="subtitulo"/>
            </VBox>

            <!-- SELECCIONAR CUENTA -->
            <VBox spacing="10" styleClass="panel-formulario">

                <Label text="Seleccionar cuenta" styleClass="titulo-seccion"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Cuenta:"/>

                    <ComboBox fx:id="comboCuentas"
                              promptText="Cuenta compartida"
                              onAction="#seleccionarCuenta"
                              prefWidth="220"/>

                    <Button text="Nueva cuenta"
                            onAction="#nuevaCuenta"
                            styleClass="boton-secundario"/>
                </HBox>

            </VBox>

            <!-- DATOS DE LA CUENTA -->
            <VBox spacing="10" styleClass="panel-formulario">

                <Label text="Datos de la cuenta" styleClass="titulo-seccion"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="campoNombreCuenta"
                               promptText="Nombre de la cuenta"
                               prefWidth="240"/>

                    <Button text="Crear cuenta"
                            onAction="#guardarCuenta"
                            styleClass="boton-primario"/>

                    <Button text="Eliminar cuenta"
                            onAction="#eliminarCuenta"
                            styleClass="boton-peligro"/>

                    <Button text="Reiniciar saldos"
                            onAction="#reiniciarSaldos"
                            styleClass="boton-secundario"/>
                </HBox>

            </VBox>

            <!-- PERSONAS -->
            <VBox spacing="8" styleClass="panel-tabla">

                <Label text="Personas de la cuenta" styleClass="titulo-seccion"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="campoPersona"
                               promptText="Nombre persona"
                               prefWidth="220"/>

                    <Button text="Añadir persona"
                            onAction="#añadirPersona"
                            styleClass="boton-primario"/>

                    <Button text="Eliminar persona seleccionada"
                            onAction="#eliminarPersona"
                            styleClass="boton-peligro"/>

                    <Button text="Guardar porcentajes"
                            onAction="#guardarPorcentajes"
                            styleClass="boton-exito"/>
                </HBox>

                <TableView fx:id="tablaPersonas" prefHeight="170" editable="true">
                    <columns>
                        <TableColumn fx:id="colNombrePersona" text="Persona" prefWidth="240"/>
                        <TableColumn fx:id="colPorcentajePersona" text="Porcentaje (%)" prefWidth="180"/>
                    </columns>
                </TableView>

            </VBox>

            <!-- SALDOS -->
            <VBox spacing="8" styleClass="panel-tabla">

                <Label fx:id="labelCuenta"
                       text="Cuenta actual: ninguna"
                       styleClass="titulo-seccion"/>

                <Label text="Saldos de la cuenta" styleClass="subtitulo"/>

                <TableView fx:id="tablaSaldos" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colPersona" text="Persona" prefWidth="240"/>
                        <TableColumn fx:id="colSaldo" text="Saldo (€)" prefWidth="160"/>
                    </columns>
                </TableView>

            </VBox>

        </VBox>

    </content>

</ScrollPane>